import javautil..HashMap;

class Student {
    private int studentID;
    private String studentName;

    // Constructor
    public Student(int studentID, String studentName) {
        this.studentID = studentID;
        this.studentName = studentName;
    }

    // Getter
    public int getStudentID() {
        return studentID;
    }

    public String getStudentName() {
        return studentName;
    }

    // Setter
    public void setStudentName(String studentName) {
        this.studentName = studentName;
    }

    // Display student information
    @Override
    public String toString() {
        return studentName;
    }
}


class StudentManager {

    private HashMap<Integer, Student> students;

    // Constructor
    public StudentManager() {
        students = new HashMap<>();
    }

    // ADD STUDENT
    public void addStudent(int id, String name) {
        students.put(id, new Student(id, name));
    }

    // DISPLAY ALL STUDENTS
    public void displayAllStudents() {
        System.out.println(students);
    }

    // DISPLAY A SPECIFIC STUDENT
    public void displayStudent(int id) {
        if (students.containsKey(id)) {
            System.out.println(students.get(id));
        } else {
            System.out.println("Student not found.");
        }
    }

    // UPDATE STUDENT NAME
    public void updateStudent(int id, String newName) {
        if (students.containsKey(id)) {
            students.get(id).setStudentName(newName);
        } else {
            System.out.println("Student not found.");
        }
    }

    // REMOVE STUDENT
    public void removeStudent(int id) {
        students.remove(id);
    }

    // CHECK IF STUDENT EXISTS
    public boolean containsStudent(int id) {
        return students.containsKey(id);
    }

    // DISPLAY NUMBER OF STUDENTS
    public int getTotalStudents() {
        return students.size();
    }

    // CLEAR ALL STUDENTS
    public void clearStudents() {
        students.clear();
    }
}


public class Main {
    public static void main(String[] args) {

        // CREATE STUDENT MANAGER OBJECT
        StudentManager manager = new StudentManager();

        // ADD STUDENTS
        manager.addStudent(1001, "Juan Dela Cruz");
        manager.addStudent(1002, "Maria Santos");
        manager.addStudent(1003, "Pedro Garcia");
        manager.addStudent(1004, "Ana Reyes");
        manager.addStudent(1004, "Ana Reyes"); // Duplicate Key
        manager.addStudent(1005, "John Lim");

        // DISPLAY ALL STUDENTS
        System.out.println("All Students:");
        manager.displayAllStudents();

        // DISPLAY A SPECIFIC STUDENT
        System.out.println("\nStudent with ID 1002:");
        manager.displayStudent(1002);

        // UPDATE A STUDENT'S NAME
        manager.updateStudent(1003, "Pedro Ramirez");

        System.out.println("\nAfter Updating Student ID 1003:");
        manager.displayAllStudents();

        // REMOVE A STUDENT
        manager.removeStudent(1001);

        System.out.println("\nAfter Removing Student ID 1001:");
        manager.displayAllStudents();

        // CHECK IF A KEY EXISTS
        System.out.println("\nIs Student ID 1005 existing?");
        System.out.println(manager.containsStudent(1005));

        // DISPLAY NUMBER OF STUDENTS
        System.out.println("\nTotal Students:");
        System.out.println(manager.getTotalStudents());

        // CLEAR ALL ELEMENTS
        manager.clearStudents();

        // DISPLAY ALL ELEMENTS
        System.out.println("\nAfter Clearing All Students:");
        manager.displayAllStudents();
    }
}
